/* =========================================================
   Bhim Gurung — Landing page
   Look & feel per Design.md (editorial / minimal / red accent)
   ========================================================= */

:root {
  /* Color */
  --ink: #111111;
  --ink-soft: #1f1f1f;
  --muted: #6c7179;
  --line: #d1d3d6;
  --paper: #f7f7f7;
  --white: #ffffff;
  --accent: #e63946;
  --accent-rgb: 230, 57, 70;
  --tint-cream: #fefee8;
  --tint-rose: #fdedee;
  --tint-green: #eefff3;

  /* On dark */
  --muted-dark: #9aa0a8;
  --line-dark: #333638;

  /* Radii */
  --r-sm: 12px;
  --r-md: 20px;
  --r-lg: 24px;
  --r-xl: 40px;
  --r-pill: 100px;

  /* Layout */
  --container: 1200px;
  --pad-x: 24px;

  /* Type */
  --font: "Instrument Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;

  /* Shadow */
  --shadow: 0 1px 2px rgba(17, 17, 17, 0.04), 0 12px 32px -12px rgba(17, 17, 17, 0.10);
  --shadow-hover: 0 2px 4px rgba(17, 17, 17, 0.06), 0 24px 48px -16px rgba(17, 17, 17, 0.16);
}

/* ---------- Reset ---------- */
*,
*::before,
*::after { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--font);
  font-weight: 400;
  color: var(--ink);
  background: var(--white);
  line-height: 1.4;
  letter-spacing: -0.011em;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

h1, h2, h3, p, ul, ol, figure { margin: 0; }
ul, ol { list-style: none; padding: 0; }

a {
  color: inherit;
  text-decoration: none;
  transition: color 0.25s ease, opacity 0.25s ease;
}

img { max-width: 100%; display: block; }

button { font-family: inherit; cursor: pointer; }

/* ---------- Layout helpers ---------- */
.container {
  width: 100%;
  max-width: calc(var(--container) + var(--pad-x) * 2);
  margin-inline: auto;
  padding-inline: var(--pad-x);
}

.section {
  padding-block: 120px;
}

.section--dark {
  background: var(--ink-soft);
  color: var(--white);
}

.eyebrow {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--muted);
  text-transform: uppercase;
}
.eyebrow--light { color: var(--muted-dark); }

.h2 {
  font-size: clamp(28px, 4vw, 36px);
  font-weight: 500;
  line-height: 1.16;
  letter-spacing: -0.02em;
  color: var(--ink);
  max-width: 16ch;
}
.h2--light { color: var(--white); max-width: 18ch; }

.section-head {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: clamp(48px, 6vw, 80px);
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 46px;
  padding-inline: 24px;
  border-radius: var(--r-pill);
  border: 1px solid transparent;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  white-space: nowrap;
  transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
              background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  will-change: transform;
}
.btn:hover { transform: translateY(-2px) scale(1.015); }
.btn:active { transform: translateY(0) scale(1); }

.btn--dark { background: var(--ink); color: var(--white); }
.btn--dark:hover { background: #000; box-shadow: var(--shadow-hover); }

.btn--light { background: var(--white); color: var(--ink); }
.btn--light:hover { box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5); }

.btn--ghost { background: transparent; border-color: var(--line); color: var(--ink); }
.btn--ghost:hover { border-color: var(--ink); box-shadow: var(--shadow-hover); }

.btn--ghost-invert { background: transparent; border-color: rgba(255, 255, 255, 0.4); color: var(--white); }
.btn--ghost-invert:hover { border-color: var(--white); background: rgba(255, 255, 255, 0.08); box-shadow: 0 8px 28px -10px rgba(255, 255, 255, 0.18); }

/* =========================================================
   NAV
   ========================================================= */
.nav {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 100;
  padding-block: 14px;
  transition: background 0.35s ease, box-shadow 0.35s ease, backdrop-filter 0.35s ease;
}
.nav.is-scrolled {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: saturate(180%) blur(14px);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  box-shadow: 0 1px 0 rgba(17, 17, 17, 0.06);
}
.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.nav__brand {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.nav__logo {
  display: block;
  height: 30px;
  width: auto;
  transition: opacity 0.35s ease;
}
/* The dark-text lockup sits stacked on top and fades in once the bar
   turns solid on scroll; the light-text one shows over the hero. */
.nav__logo--dark {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
}
.nav.is-scrolled .nav__logo--light { opacity: 0; }
.nav.is-scrolled .nav__logo--dark { opacity: 1; }
.nav__links {
  display: flex;
  gap: 32px;
  font-size: 15px;
  font-weight: 500;
}
.nav__links a { color: var(--white); transition: color 0.25s ease, opacity 0.25s ease; }
.nav__links a:hover { opacity: 0.72; }
.nav.is-scrolled .nav__links a { color: var(--muted); }
.nav.is-scrolled .nav__links a:hover { color: var(--ink); opacity: 1; }
.nav__cta { height: 42px; padding-inline: 20px; }
.nav.is-scrolled .nav__cta { background: var(--ink); color: var(--white); }
.nav.is-scrolled .nav__cta:hover { background: #000; box-shadow: var(--shadow-hover); }

.nav__toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
  background: var(--white);
}
.nav__toggle span {
  display: block;
  width: 18px;
  height: 1.5px;
  margin-inline: auto;
  background: var(--ink);
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.nav.is-open .nav__toggle span:nth-child(1) { transform: translateY(3.25px) rotate(45deg); }
.nav.is-open .nav__toggle span:nth-child(2) { transform: translateY(-3.25px) rotate(-45deg); }

/* =========================================================
   BADGE — shared "Available for consultation" pill,
   used by hero-variations.html
   ========================================================= */
.hero__badge {
  position: absolute;
  top: 20px;
  left: 20px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: var(--r-pill);
  background: var(--tint-green);
  color: #0f7a43;
  font-size: 14px;
  font-weight: 500;
  box-shadow: var(--shadow);
}
.hero__badge .dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #12b76a;
  box-shadow: 0 0 0 0 rgba(18, 183, 106, 0.5);
  animation: pulse 2.4s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(18, 183, 106, 0.5); }
  70% { box-shadow: 0 0 0 8px rgba(18, 183, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(18, 183, 106, 0); }
}

/* Badge load intro — CSS only, so content is always visible even without JS.
   Applied only when the user hasn't asked to reduce motion. */
@media (prefers-reduced-motion: no-preference) {
  .hero__badge { animation: heroFade 0.8s ease both 0.5s; }
}
@keyframes heroFade {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: none; }
}

/* =========================================================
   SHOWCASE — solid-slate full-bleed hero beat
   ========================================================= */
.showcase {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: 95vh;
  padding-block: clamp(72px, 10vw, 120px);
  background: #808788;
  color: var(--white);
}
.showcase__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
/* Dark-to-clear gradient over the (mirrored) empty side of the photo,
   so white text stays legible without a separate background block. */
.showcase__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(8, 10, 12, 0.72) 0%,
    rgba(8, 10, 12, 0.46) 34%,
    rgba(8, 10, 12, 0.12) 58%,
    rgba(8, 10, 12, 0) 74%
  );
}
.showcase__photo-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* Anchor to the top of the photo so the vertical crop is taken from
     the bottom — keeps the headroom above Bhim instead of clipping it. */
  object-position: center top;
  /* Source photo has Bhim on the left; mirrored so he sits on the
     right and the gradient/text land on the empty side of the frame. */
  transform: scaleX(-1);
}
.showcase__inner {
  position: relative;
  z-index: 1;
}
.showcase__body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
  max-width: 620px;
}
.showcase__title {
  width: 600px;
  max-width: 100%;
  font-size: clamp(32px, 4.2vw, 52px);
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--white);
}
.showcase__lead {
  font-size: 18px;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.82);
  max-width: 46ch;
}
.showcase__ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 8px;
}

@media (max-width: 760px) {
  .showcase {
    flex-direction: column;
    align-items: stretch;
    min-height: auto;
    padding-block: 72px 0;
  }
  .showcase__media {
    position: static;
    height: 340px;
    margin-top: 32px;
    order: 3;
  }
  .showcase__media::after { display: none; }
  .showcase__photo-img {
    position: static;
    width: 100%;
    height: 100%;
    /* Un-mirrored on mobile: there's no overlaid text to coordinate
       with here, so the photo reads naturally on its own. */
    transform: none;
  }
  .showcase__inner { order: 1; }
  .showcase__body { max-width: none; }
  .showcase__lead { max-width: none; }
}

/* =========================================================
   ABOUT
   ========================================================= */
.about__grid {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: clamp(32px, 5vw, 72px) clamp(32px, 6vw, 80px);
  align-items: start;
}
.about__grid .eyebrow { padding-top: 8px; }
.about__lead { display: flex; flex-direction: column; gap: 28px; }
.about__lead .h2 { max-width: 26ch; }
.about__text {
  font-size: 19px;
  line-height: 1.55;
  color: var(--muted);
  max-width: 54ch;
}
.about__stats {
  grid-column: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
}
.stat { display: flex; flex-direction: column; gap: 6px; padding-top: 28px; }
.stat__num {
  font-size: clamp(40px, 5vw, 56px);
  font-weight: 500;
  letter-spacing: -0.04em;
  line-height: 1;
  color: var(--ink);
}
.stat__label { font-size: 15px; color: var(--muted); max-width: 20ch; }

/* =========================================================
   LEADERSHIP
   ========================================================= */
.leader__grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: clamp(32px, 5vw, 72px) clamp(32px, 6vw, 80px);
  align-items: center;
}

.leader__media { position: relative; }
.leader__photo {
  aspect-ratio: 4 / 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--paper);
  border: 1px dashed var(--line);
  border-radius: var(--r-lg);
  color: var(--muted);
}
.leader__photo svg { width: 40px; height: 40px; opacity: 0.7; }
.leader__photo span { font-size: 13px; font-weight: 500; }

.leader__logo {
  position: absolute;
  left: -18px;
  bottom: -18px;
  width: 84px;
  height: 84px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 8px;
  background: var(--white);
  border: 1px dashed var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow);
  color: var(--muted);
}
.leader__logo svg { width: 22px; height: 22px; opacity: 0.7; }
.leader__logo span { font-size: 11px; font-weight: 500; }

.leader__body { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
.leader__role {
  font-size: 14px;
  font-weight: 500;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.leader__name {
  font-size: clamp(26px, 3vw, 32px);
  font-weight: 500;
  letter-spacing: -0.02em;
}
.leader__text { font-size: 17px; color: var(--muted); line-height: 1.55; max-width: 52ch; }
.leader__cta { margin-top: 6px; }

/* =========================================================
   BUSINESS & ENTREPRENEURSHIP — capability grid
   ========================================================= */
.biz__intro { font-size: 17px; color: var(--muted); line-height: 1.55; max-width: 56ch; }

.biz__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.biz__card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18px;
  padding: 28px 24px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  transition: box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.35s ease;
}
.biz__card:hover { box-shadow: var(--shadow-hover); transform: translateY(-4px); border-color: var(--ink); }

.biz__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  flex-shrink: 0;
  transition: background 0.35s ease, color 0.35s ease;
}
.biz__icon svg { width: 22px; height: 22px; }
.biz__card:hover .biz__icon { background: var(--tint-rose); color: var(--accent); }

.biz__title { font-size: 15.5px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.35; }

.biz__summary {
  margin-top: clamp(40px, 5vw, 64px);
  padding-top: clamp(32px, 4vw, 44px);
  border-top: 1px solid var(--line);
  font-size: 19px;
  line-height: 1.6;
  color: var(--muted);
  max-width: 68ch;
}

/* =========================================================
   SERVICES — Icon Grid
   ========================================================= */
.svcD__intro { font-size: 17px; color: var(--muted); line-height: 1.55; max-width: 56ch; }

.svcD__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.svcD__cell {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 44px 40px 40px;
  min-height: 340px;
  border-bottom: 1px solid var(--line);
  border-right: 1px solid var(--line);
  transition: background 0.4s ease;
}
.svcD__cell:nth-child(3n) { border-right: 0; }
.svcD__cell:nth-last-child(-n+3) { border-bottom: 0; }
.svcD__cell:hover { background: var(--paper); }

.svcD__head { display: flex; align-items: baseline; gap: 12px; }
.svcD__index { font-size: 14px; font-weight: 500; color: var(--accent); letter-spacing: 0.04em; }
.svcD__title { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; }
.svcD__text { font-size: 15px; color: var(--muted); line-height: 1.5; max-width: 32ch; }

.svcD__icon {
  margin-top: auto;
  align-self: flex-start;
  width: clamp(56px, 7vw, 84px);
  height: clamp(56px, 7vw, 84px);
  color: var(--ink);
  opacity: 0.82;
  transition: color 0.35s ease, opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.svcD__icon svg { width: 100%; height: 100%; display: block; }
.svcD__cell:hover .svcD__icon { color: var(--accent); opacity: 1; transform: translateY(-3px); }

/* =========================================================
   EXPLORER — interactive list + detail panel.
   Shared component: a left index of tabs and a right detail
   panel that swaps content on hover/click. Used as an
   alternate layout under both Services and Business &
   Entrepreneurship — same visual language, different data.
   ========================================================= */
.variant-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: var(--r-pill);
  background: var(--ink);
  color: var(--white);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.explorer {
  display: grid;
  grid-template-columns: 340px 1fr;
  border: 1px solid var(--line);
  overflow: hidden;
}
.explorer__nav {
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  max-height: 560px;
  overflow-y: auto;
}
.explorer__tab {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 18px 22px;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--line);
  text-align: left;
  font-family: inherit;
  transition: background 0.3s ease;
}
.explorer__tab:last-child { border-bottom: 0; }
.explorer__tab:hover { background: var(--paper); }
.explorer__tab-num { font-size: 13px; font-weight: 500; color: var(--muted); }
.explorer__tab-title { font-size: 16px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }
.explorer__tab.is-active { background: var(--ink); }
.explorer__tab.is-active .explorer__tab-num { color: var(--muted-dark); }
.explorer__tab.is-active .explorer__tab-title { color: var(--white); }

.explorer__panel {
  position: relative;
  padding: 56px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 18px;
  min-height: 420px;
  background: var(--paper);
}
.explorer__panel-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--white);
  color: var(--accent);
  flex-shrink: 0;
}
.explorer__panel-icon svg { width: 28px; height: 28px; }
.explorer__panel-title { font-size: clamp(28px, 3vw, 38px); font-weight: 500; letter-spacing: -0.02em; max-width: 20ch; }
.explorer__panel-text { font-size: 17px; color: var(--muted); line-height: 1.55; max-width: 46ch; }

@media (prefers-reduced-motion: no-preference) {
  .explorer__panel.is-swapping { animation: explorerPanelIn 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
}
@keyframes explorerPanelIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: none; }
}

@media (max-width: 900px) {
  .explorer { grid-template-columns: 1fr; }
  .explorer__nav {
    flex-direction: row;
    overflow-x: auto;
    max-height: none;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .explorer__tab { flex: 0 0 auto; border-bottom: 0; border-right: 1px solid var(--line); white-space: nowrap; }
  .explorer__panel { padding: 36px 24px; min-height: 0; }
}

/* =========================================================
   WHO WE SERVE — two-up feature cards, one accent-highlighted
   ========================================================= */
.who__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
}
.who__card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
  padding: 44px 40px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  transition: box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.who__card:hover { box-shadow: var(--shadow-hover); transform: translateY(-4px); }

.who__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  flex-shrink: 0;
}
.who__icon svg { width: 26px; height: 26px; }

.who__title { font-size: 22px; font-weight: 500; letter-spacing: -0.02em; }
.who__text { font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 42ch; }

.who__card--accent {
  background: var(--accent);
  border-color: transparent;
  color: var(--white);
}
.who__card--accent .who__icon { background: rgba(255, 255, 255, 0.18); color: var(--white); }
.who__card--accent .who__text { color: rgba(255, 255, 255, 0.86); }
.who__card--accent:hover { box-shadow: 0 24px 48px -16px rgba(var(--accent-rgb), 0.45); }

/* =========================================================
   WHY CHOOSE US — four-up icon cards
   ========================================================= */
.why__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.why__card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  padding: 32px 28px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  transition: box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.35s ease;
}
.why__card:hover { box-shadow: var(--shadow-hover); transform: translateY(-4px); border-color: var(--ink); }

.why__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  transition: background 0.35s ease, color 0.35s ease;
}
.why__icon svg { width: 24px; height: 24px; }
.why__card:hover .why__icon { background: var(--tint-rose); color: var(--accent); }

.why__title { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
.why__text { font-size: 15px; line-height: 1.55; color: var(--muted); }

/* =========================================================
   TEAM — four-up profile cards
   ========================================================= */
.team__intro { font-size: 17px; color: var(--muted); line-height: 1.55; max-width: 56ch; }

.team__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.team__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
  padding: 40px 28px;
  background: var(--white);
  transition: box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.team__card:hover { box-shadow: var(--shadow-hover); transform: translateY(-4px); }

.team__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.02em;
  overflow: hidden;
}
.team__avatar img { width: 100%; height: 100%; object-fit: cover; }
.team__card:hover .team__avatar { background: var(--tint-rose); color: var(--accent); }

.team__name { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
.team__role { font-size: 14px; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; color: var(--muted); }

/* =========================================================
   PROCESS
   ========================================================= */
.process__grid {
  display: grid;
  grid-template-columns: 2fr 3fr;
  gap: clamp(32px, 5vw, 80px);
  align-items: start;
}
.process__intro { display: flex; flex-direction: column; gap: 18px; }

.steps {
  display: flex;
  flex-direction: column;
}
.step {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 24px;
  margin-inline: -20px;
  padding: 32px 20px;
  border-bottom: 1px solid var(--line);
  transition: background 0.3s ease;
}
.step:first-child { padding-top: 4px; }
.step:hover { background: var(--paper); }
.step__num {
  font-size: 22px;
  font-weight: 500;
  color: var(--accent);
  letter-spacing: 0.02em;
  transition: color 0.3s ease;
}
.step__body { display: flex; flex-direction: column; gap: 8px; }
.step__title { font-size: 22px; font-weight: 500; letter-spacing: -0.02em; transition: color 0.3s ease; }
.step:hover .step__title { color: var(--accent); }
.step__text { font-size: 16px; color: var(--muted); line-height: 1.5; max-width: 60ch; }

/* =========================================================
   TESTIMONIALS
   ========================================================= */
.testi .section-head {
  align-items: center;
  text-align: center;
  max-width: 620px;
  margin-inline: auto;
}
.testi .section-head .h2 { max-width: 22ch; }
.testi__intro { font-size: 17px; color: var(--muted); line-height: 1.55; }

.testi__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(32px, 5vw, 64px);
}
.testi__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 22px;
  padding: 0;
  margin: 0;
  background: none;
}

.testi__mark {
  display: flex;
  color: var(--accent);
}
.testi__mark svg { width: 34px; height: auto; }

.testi__quote {
  font-size: 19px;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.01em;
  color: var(--ink);
  max-width: 34ch;
}
.testi__quote::before { content: "\201C"; }
.testi__quote::after { content: "\201D"; }

.testi__person {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding-top: 8px;
}
.testi__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--muted);
  overflow: hidden;
}
.testi__avatar img { width: 100%; height: 100%; object-fit: cover; }
.testi__avatar svg { width: 26px; height: 26px; }

.testi__name { font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }
.testi__meta { font-size: 14px; color: var(--muted); letter-spacing: 0.01em; }

/* =========================================================
   FAQ
   ========================================================= */
.faq__grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(32px, 5vw, 80px);
  align-items: start;
}
.faq__head { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
.faq__head .btn { margin-top: 8px; }
.faq__list { display: flex; flex-direction: column; }
.qa {
  border-top: 1px solid var(--line);
  padding: 6px 0;
}
.qa:last-child { border-bottom: 1px solid var(--line); }
.qa summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 4px;
  font-size: 19px;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.qa summary::-webkit-details-marker { display: none; }
.qa summary::after {
  content: "+";
  font-size: 26px;
  font-weight: 400;
  color: var(--muted);
  transition: transform 0.35s ease, color 0.25s ease;
  line-height: 1;
}
.qa[open] summary::after { transform: rotate(45deg); color: var(--ink); }
.qa p {
  padding: 0 4px 24px;
  font-size: 16.5px;
  color: var(--muted);
  line-height: 1.55;
  max-width: 60ch;
}
.qa a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

/* =========================================================
   CONTACT (dark)
   ========================================================= */
.contact__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 6vw, 88px);
  align-items: start;
}
.contact__title { font-size: clamp(30px, 4.4vw, 44px); line-height: 1.1; letter-spacing: -0.03em; }
.contact__intro { display: flex; flex-direction: column; gap: 40px; }
.contact__list { display: flex; flex-direction: column; gap: 4px; }
.contact__list li {
  display: grid;
  grid-template-columns: 72px 1fr;
  align-items: center;
  gap: 16px;
  padding: 16px 0;
  border-top: 1px solid var(--line-dark);
  font-size: 17px;
}
.contact__list span { color: var(--muted-dark); font-size: 14px; }
.contact__list a:hover { color: var(--accent); }

.contact__form { display: flex; flex-direction: column; gap: 18px; }
.field { display: flex; flex-direction: column; gap: 8px; }
.field label { font-size: 14px; color: var(--muted-dark); letter-spacing: 0.01em; }
.field input,
.field textarea {
  font-family: inherit;
  font-size: 16px;
  color: var(--white);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line-dark);
  border-radius: var(--r-sm);
  padding: 14px 16px;
  transition: border-color 0.25s ease, background 0.25s ease;
  resize: vertical;
}
.field input:focus,
.field textarea:focus {
  outline: none;
  border-color: var(--accent);
  background: rgba(var(--accent-rgb), 0.06);
}
.field.is-invalid input,
.field.is-invalid textarea { border-color: #ef6b6b; }
.field__error { font-size: 13px; color: #ef8a8a; min-height: 1em; }
.contact__form .btn { align-self: flex-start; margin-top: 6px; }
.form__status { font-size: 15px; color: var(--tint-green); min-height: 1.2em; }
.hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

/* =========================================================
   FOOTER
   ========================================================= */
.footer { padding-top: clamp(64px, 8vw, 110px); padding-bottom: 40px; }
.footer__inner {
  display: grid;
  grid-template-columns: 1.6fr repeat(3, 1fr);
  gap: 40px;
  padding-bottom: 56px;
  border-bottom: 1px solid var(--line-dark);
}
.footer__brand { display: flex; flex-direction: column; gap: 10px; }
.footer__logo { height: 32px; width: auto; align-self: flex-start; }
.footer__role { font-size: 15px; color: var(--muted-dark); }
.footer__col { display: flex; flex-direction: column; gap: 14px; }
.footer__label { font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-dark); }
.footer__col a { font-size: 16px; color: #d5d7da; }
.footer__col a:hover { color: var(--white); }
.footer__base {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 28px;
  font-size: 14px;
  color: var(--muted-dark);
}
.footer__top:hover { color: var(--white); }

/* =========================================================
   AFFILIATIONS — logo wall
   Real partner / venture logos, optically normalised into a
   centred wrap. Three orgs without art yet show as a name —
   swap a .logos__name <span> for an <img> when its logo lands.
   ========================================================= */
.logos__head { align-items: center; text-align: center; }
.logos .section-head .h2 { max-width: 30ch; }
.logos__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16px;
  max-width: 896px;
  margin-inline: auto;
}
.logos__cell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 208px;
  height: 128px;
  padding: 22px 26px;
  border: 1px solid var(--line);
  transition: border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
              background 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.logos__cell:hover { border-color: var(--ink); background: var(--paper); }
.logos__img {
  max-width: 100%;
  max-height: 60px;
  width: auto;
  height: auto;
  object-fit: contain;
}
.logos__name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--muted);
  text-align: center;
}

@media (max-width: 720px) {
  .logos__grid { gap: 12px; max-width: 428px; }
  .logos__cell { width: calc(50% - 6px); height: 108px; padding: 18px; }
  .logos__img { max-height: 52px; }
}
@media (max-width: 400px) {
  .logos__grid { max-width: 260px; }
  .logos__cell { width: 100%; }
}

/* =========================================================
   SCROLL REVEAL — progressive enhancement.
   Elements stay fully visible with no JS (no-JS / JS-blocked);
   the "js" class (set inline in <head>, before paint) opts an
   element into a one-time fade + rise once main.js's
   IntersectionObserver marks it .is-revealed. Reduced-motion
   users get the instant, always-visible override further down.
   ========================================================= */
/* translate (not transform) for the reveal offset, so it never
   collides with .btn:hover's transform on elements that are
   both [data-reveal] and a button (e.g. the FAQ ghost CTA). */
.js [data-reveal] {
  opacity: 0;
  translate: 0 20px;
  transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
              translate 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.js [data-reveal].is-revealed {
  opacity: 1;
  translate: none;
}
/* Cascade siblings inside a group instead of popping in together. */
[data-reveal-group] > [data-reveal]:nth-child(2) { transition-delay: 0.07s; }
[data-reveal-group] > [data-reveal]:nth-child(3) { transition-delay: 0.14s; }
[data-reveal-group] > [data-reveal]:nth-child(4) { transition-delay: 0.21s; }
[data-reveal-group] > [data-reveal]:nth-child(5) { transition-delay: 0.28s; }
[data-reveal-group] > [data-reveal]:nth-child(6) { transition-delay: 0.35s; }
[data-reveal-group] > [data-reveal]:nth-child(7) { transition-delay: 0.42s; }
[data-reveal-group] > [data-reveal]:nth-child(8) { transition-delay: 0.49s; }
[data-reveal-group] > [data-reveal]:nth-child(9) { transition-delay: 0.56s; }
[data-reveal-group] > [data-reveal]:nth-child(10) { transition-delay: 0.63s; }

/* =========================================================
   RESPONSIVE
   ========================================================= */
@media (max-width: 900px) {
  .nav__links, .nav__cta { display: none; }
  .nav__toggle { display: flex; }
  .nav.is-open .nav__links {
    display: flex;
    position: absolute;
    top: calc(100% + 8px);
    left: var(--pad-x);
    right: var(--pad-x);
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-hover);
  }
  .nav.is-open .nav__links a { padding: 12px 14px; border-radius: var(--r-sm); }
  .nav.is-open .nav__links a:hover { background: var(--paper); }

  .about__grid { grid-template-columns: 1fr; }
  .about__stats { grid-column: 1; }

  .leader__grid { grid-template-columns: 1fr; }
  .leader__photo { aspect-ratio: 16 / 10; max-width: 320px; }
  .leader__logo { left: -10px; bottom: -10px; width: 68px; height: 68px; }

  .process__grid { grid-template-columns: 1fr; gap: 32px; }

  .biz__grid { grid-template-columns: repeat(3, 1fr); }

  .who__grid { grid-template-columns: 1fr; }
  .who__card { padding: 36px 28px; }

  .why__grid { grid-template-columns: repeat(2, 1fr); }

  .team__grid { grid-template-columns: repeat(2, 1fr); }

  .testi__grid { grid-template-columns: 1fr; max-width: 440px; margin-inline: auto; gap: 52px; }
  .testi__card { padding: 0; }

  .svcD__grid { grid-template-columns: 1fr; }
  .svcD__cell {
    min-height: 0;
    padding: 32px 4px;
    border-right: 0;
  }
  .svcD__cell:nth-last-child(-n+3) { border-bottom: 1px solid var(--line); }
  .svcD__cell:last-child { border-bottom: 0; }
  .svcD__icon { margin-top: 8px; }
  .faq__grid { grid-template-columns: 1fr; }
  .contact__grid { grid-template-columns: 1fr; }
  .footer__inner { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 560px) {
  :root { --pad-x: 20px; }
  .biz__grid { grid-template-columns: repeat(2, 1fr); }
  .why__grid { grid-template-columns: 1fr; }
  .team__grid { grid-template-columns: 1fr; }
  .svcD__cell { padding-block: 26px; }
  .svcD__text { max-width: none; }
  .about__stats { grid-template-columns: 1fr; gap: 0; }
  .stat { padding-block: 22px; border-bottom: 1px solid var(--line); }
  .step { grid-template-columns: 1fr; gap: 10px; margin-inline: 0; padding: 24px 0; }
  .footer__inner { grid-template-columns: 1fr; gap: 32px; }
  .footer__base { flex-direction: column; align-items: flex-start; }
  .contact__list li { grid-template-columns: 60px 1fr; }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */
@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
  .js [data-reveal] { opacity: 1 !important; translate: none !important; }
}
