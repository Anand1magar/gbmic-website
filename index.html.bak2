    <!-- ============ PROCESS ============ -->
    <section class="process section" id="process">
      <div class="container process__grid">
        <div class="process__intro" data-reveal-group>
          <p class="eyebrow" data-reveal>Process</p>
          <h2 class="h2" data-reveal>
            A clear path from first call to a lasting partnership.
          </h2>
        </div>

        <ol class="steps" data-reveal-group>
          <li class="step" data-reveal>
            <span class="step__num">01</span>
            <div class="step__body">
              <h3 class="step__title">Book a call</h3>
              <p class="step__text">We start with a conversation about where the business is and where you want it to go.</p>
            </div>
          </li>
          <li class="step" data-reveal>
            <span class="step__num">02</span>
            <div class="step__body">
              <h3 class="step__title">Discovery</h3>
              <p class="step__text">A close look at the numbers, the operation, and the opportunities on the table.</p>
            </div>
          </li>
          <li class="step" data-reveal>
            <span class="step__num">03</span>
            <div class="step__body">
              <h3 class="step__title">Strategy</h3>
              <p class="step__text">A plan you can act on — priorities, timelines, and the reasoning behind each.</p>
            </div>
          </li>
          <li class="step" data-reveal>
            <span class="step__num">04</span>
            <div class="step__body">
              <h3 class="step__title">Execution</h3>
              <p class="step__text">Hands-on support putting the plan to work, adjusting as reality comes in.</p>
            </div>
          </li>
          <li class="step" data-reveal>
            <span class="step__num">05</span>
            <div class="step__body">
              <h3 class="step__title">Ongoing support</h3>
              <p class="step__text">A steady partner for the decisions that keep coming after the launch.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

