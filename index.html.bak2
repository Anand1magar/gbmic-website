      </div>

      <div class="container showcase__inner">
        <div class="showcase__body" data-reveal-group>
          <p class="eyebrow eyebrow--light" data-reveal>Global CEO · GBMIC</p>
          <h2 class="showcase__title" data-reveal>Helping businesses grow through strategic management.</h2>
          <p class="showcase__lead" data-reveal>
            Bhim Gurung leads Global Business Management &amp; Investment Co. and is a
            trusted voice in Nebraska's Bhutanese-American community — guiding owners
            to manage, invest, and grow with clarity.
          </p>
          <div class="showcase__ctas" data-reveal>
            <a href="#contact" class="btn btn--light">Let's talk</a>
            <a href="#services" class="btn btn--ghost-invert">See services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT / STAT ============ -->
    <section class="about section" id="about">
      <div class="container about__grid">
        <p class="eyebrow" data-reveal>About</p>
        <div class="about__lead">
          <h2 class="h2" data-reveal>
            Two decades of leadership across business, investment, and community.
          </h2>
          <p class="about__text" data-reveal>
            Bhim Gurung leads GBMIC with a simple belief: sound management and patient
            investment build businesses that last. Alongside his work with clients, he is a
            trusted voice in Nebraska's Bhutanese-American community — connecting people to
            opportunity and helping them find their footing.
          </p>
        </div>
        <div class="about__stats">
          <div class="stat">
            <span class="stat__num">20+</span>
            <span class="stat__label">Years leading businesses</span>
          </div>
          <div class="stat">
            <span class="stat__num">9</span>
            <span class="stat__label">Service areas under one roof</span>
          </div>
          <div class="stat">
            <span class="stat__num">100%</span>
            <span class="stat__label">Focused on your outcome</span>
          </div>
        </div>
      </div>
    </section>

